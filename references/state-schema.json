{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperFusion Opus-lead v0.3 state",
  "type": "object",
  "required": [
    "schema_version",
    "architecture",
    "configuration",
    "initial_executor",
    "active_executor",
    "owner",
    "attempts",
    "sessions",
    "task_id",
    "phase",
    "lead",
    "lead_target_model",
    "lead_model",
    "iteration",
    "base_commit",
    "baseline_dirty",
    "writer",
    "reviews",
    "escalations",
    "result_failures",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "architecture": {
      "const": "opus-lead-v0.3"
    },
    "configuration": {
      "type": "object",
      "required": [
        "lead",
        "lead_model",
        "lead_takeover",
        "external"
      ]
    },
    "initial_executor": {
      "enum": [
        "grok",
        "antigravity"
      ]
    },
    "active_executor": {
      "enum": [
        "grok",
        "antigravity"
      ]
    },
    "owner": {
      "enum": [
        "grok",
        "antigravity",
        "lead",
        null
      ]
    },
    "attempts": {
      "type": "object",
      "required": [
        "grok",
        "antigravity",
        "lead"
      ],
      "properties": {
        "grok": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "antigravity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "lead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "properties": {
        "grok": {
          "type": [
            "string",
            "null"
          ]
        },
        "antigravity": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "phase": {
      "enum": [
        "PLAN",
        "EXECUTING",
        "REVIEW",
        "REDO",
        "ALTERNATIVE_REQUIRED",
        "DECISION_REQUIRED",
        "TAKEOVER_REQUIRED",
        "RECOVERY_REQUIRED",
        "VERIFY",
        "CLOSE",
        "BLOCKED",
        "ARCHIVED"
      ]
    },
    "lead": {
      "const": "opus"
    },
    "lead_target_model": {
      "const": "claude-opus-5-5"
    },
    "lead_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "base_commit": {
      "type": "string"
    },
    "baseline_dirty": {
      "type": "boolean"
    },
    "writer": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "task_id",
        "round",
        "owner",
        "token",
        "created_at"
      ],
      "properties": {
        "owner": {
          "enum": [
            "grok",
            "antigravity",
            "lead"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verdict",
          "rationale",
          "blocking_criteria",
          "owner",
          "round"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "pass",
              "redo",
              "alternative",
              "decision",
              "takeover"
            ]
          }
        }
      }
    },
    "escalations": {
      "type": "array"
    },
    "result_failures": {
      "type": "integer",
      "minimum": 0
    },
    "post_digest": {
      "type": "string"
    },
    "last_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation_assessment": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
