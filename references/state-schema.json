{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyperFusion state (storage schema 4)",
  "type": "object",
  "required": [
    "schema_version",
    "architecture",
    "configuration",
    "initial_executor",
    "active_executor",
    "owner",
    "attempts",
    "sessions",
    "task_id",
    "phase",
    "lead",
    "lead_target_model",
    "lead_model",
    "iteration",
    "base_commit",
    "baseline_dirty",
    "writer",
    "reviews",
    "escalations",
    "result_failures",
    "started_at",
    "routing"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "architecture": {
      "const": "opus-lead-v0.3"
    },
    "configuration": {
      "type": "object",
      "required": [
        "lead",
        "lead_model",
        "lead_takeover",
        "external",
        "routing"
      ]
    },
    "initial_executor": {
      "enum": [
        "grok",
        "antigravity",
        "sonnet",
        "luna"
      ]
    },
    "active_executor": {
      "enum": [
        "grok",
        "antigravity",
        "sonnet",
        "luna"
      ]
    },
    "owner": {
      "enum": [
        "grok",
        "antigravity",
        "sonnet",
        "luna",
        "lead",
        null
      ]
    },
    "attempts": {
      "type": "object",
      "required": [
        "grok",
        "antigravity",
        "lead",
        "sonnet",
        "luna"
      ],
      "properties": {
        "grok": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "antigravity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "lead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "sonnet": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "luna": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "properties": {
        "grok": {
          "type": [
            "string",
            "null"
          ]
        },
        "antigravity": {
          "type": [
            "string",
            "null"
          ]
        },
        "sonnet": {
          "type": [
            "string",
            "null"
          ]
        },
        "luna": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "phase": {
      "enum": [
        "PLAN",
        "REDO",
        "ALTERNATIVE_REQUIRED",
        "TAKEOVER_REQUIRED",
        "EXECUTING",
        "REVIEW",
        "DECISION_REQUIRED",
        "VERIFY",
        "RECOVERY_REQUIRED",
        "CLOSE",
        "BLOCKED",
        "ARCHIVED"
      ]
    },
    "lead": {
      "const": "opus"
    },
    "lead_target_model": {
      "const": "claude-opus-5-5"
    },
    "lead_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 13
    },
    "base_commit": {
      "type": "string"
    },
    "baseline_dirty": {
      "type": "boolean"
    },
    "writer": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "task_id",
        "round",
        "owner",
        "token",
        "created_at"
      ],
      "properties": {
        "owner": {
          "enum": [
            "grok",
            "antigravity",
            "sonnet",
            "luna",
            "lead"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verdict",
          "rationale",
          "blocking_criteria",
          "owner",
          "round"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "pass",
              "redo",
              "alternative",
              "decision",
              "takeover"
            ]
          },
          "reviewed_by": {
            "enum": [
              "lead",
              "sol",
              "grok",
              "antigravity",
              "sonnet",
              "luna"
            ]
          }
        }
      }
    },
    "escalations": {
      "type": "array"
    },
    "result_failures": {
      "type": "integer",
      "minimum": 0
    },
    "post_digest": {
      "type": "string"
    },
    "last_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation_assessment": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "routing": {
      "type": "object",
      "required": [
        "mode",
        "executor",
        "candidates",
        "reason"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "explicit"
          ]
        },
        "executor": {
          "enum": [
            "grok",
            "antigravity",
            "sonnet",
            "luna"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "enum": [
              "grok",
              "antigravity",
              "sonnet",
              "luna"
            ]
          }
        },
        "task_kind": {
          "enum": [
            "code",
            "ui",
            "image-asset",
            "tests",
            "refactor",
            "docs",
            null
          ]
        },
        "difficulty": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "reason": {
          "type": "string"
        },
        "stats": {
          "type": "object"
        },
        "unavailable": {
          "type": "object"
        }
      }
    },
    "open_consult": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "mode",
        "members",
        "digest"
      ],
      "properties": {
        "mode": {
          "enum": [
            "advisor",
            "committee"
          ]
        }
      }
    },
    "consults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "members",
          "violated",
          "touched"
        ]
      }
    },
    "consult_runs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "hint": {
      "type": [
        "object",
        "null"
      ]
    },
    "pending_review": {
      "type": [
        "object",
        "null"
      ],
      "description": "auto_apply가 꺼졌거나 적용할 수 없는 위임 판정"
    },
    "review_runs": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      }
    },
    "review_failed": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "milestone",
        "task"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "milestone": {
          "type": "string"
        },
        "task": {
          "type": "string"
        }
      }
    },
    "open_violations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "실패한 라운드가 남긴 범위 밖 파일. 되돌려지거나 허용될 때까지 다음 라운드를 막는다"
    },
    "scope_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "round": {
            "type": "integer"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "metrics_error": {
      "type": "string"
    },
    "project_error": {
      "type": "string"
    },
    "memory_error": {
      "type": "string"
    },
    "package_version": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_wall_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_error": {
      "type": "string"
    },
    "acceptance": {
      "type": [
        "object",
        "null"
      ],
      "description": "Last controller-run acceptance result for this task (acceptance-N-<stage>.json holds results and process termination evidence).",
      "properties": {
        "quiescent": {
          "type": "boolean",
          "description": "True only when every command has confirmed process-tree shutdown. Older records without this field cannot be reused."
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "enum": [
            "finish",
            "verify"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "file": {
          "type": "string"
        },
        "tree_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "ignored_after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "round",
        "stage",
        "status",
        "file"
      ],
      "additionalProperties": false
    }
  }
}
